<resources>
    <style name="Base.Theme.MySchedule" parent="Theme.Material3.DayNight.NoActionBar">
    </style>

    <style name="Theme.MySchedule" parent="Base.Theme.MySchedule">
        <!-- Light mode values -->
        <item name="appBackground">#F2F2F7</item>
        <item name="textPrimary">#1C1C1E</item>
        <item name="calendarDotColor">#FF03DAC5</item>
        <item name="android:windowBackground">@color/app_background_light</item>
    </style>

    <style name="CalendarHeaderTextStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">?attr/textPrimary</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>